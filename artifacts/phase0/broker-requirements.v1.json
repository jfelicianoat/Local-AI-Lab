        "generation_determinism",
        "exclude_from_model_learning",
        "invocation_telemetry",
        "execution_fingerprint"
      ],
      "strategies": ["single"]
    },
    "agent_experiments": {
      "minimum_contract": "2.9",
      "boolean_capabilities": [
        "exact_target_model",
        "client_tool_passthrough",
        "exclude_from_model_learning",
