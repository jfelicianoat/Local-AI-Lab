{"nodes": [{"id": "docs_security_boundary_current_security_boundary", "label": "Frontera de seguridad distribuida actual", "file_type": "document", "source_file": "docs/SECURITY_BOUNDARY_CURRENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_boundary_current_phase_a_design", "label": "PHASE_A_DESIGN: dise\u00f1o aspiracional de Fase A", "file_type": "document", "source_file": "docs/SECURITY_BOUNDARY_CURRENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_security_boundary_current_https_servidor", "label": "HTTPS remoto con validaci\u00f3n de certificado de servidor", "file_type": "rationale", "source_file": "docs/SECURITY_BOUNDARY_CURRENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python comprueba cadena, nombre y vigencia antes del pairing. Los errores de certificado son permanentes y se rechazan redirecciones para impedir reenviar bearer o c\u00f3digos de emparejamiento a otro destino."}, {"id": "docs_security_boundary_current_bearer_revocable", "label": "Identidad Worker con pairing y bearer revocable", "file_type": "concept", "source_file": "docs/SECURITY_BOUNDARY_CURRENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La revocaci\u00f3n invalida heartbeat, claim, renovaci\u00f3n, transferencias y finalizaci\u00f3n; no existe identidad Ed25519 por dispositivo ni certificado cliente mTLS."}, {"id": "docs_security_boundary_current_lease_fencing", "label": "Autorizaci\u00f3n por nodo/job y fencing de lease, intento y generaci\u00f3n", "file_type": "rationale", "source_file": "docs/SECURITY_BOUNDARY_CURRENT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un intento vencido o reasignado no