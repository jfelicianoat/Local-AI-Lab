{"nodes": [{"label": "Manual de uso 1.2 (2026-10-01): Desktop 0.1.1; Coordinator/Worker 0.1.0", "file_type": "document", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_manual_de_uso_manual_de_uso", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "manual de uso 1.2 (2026-10-01): desktop 0.1.1; coordinator/worker 0.1.0"}, {"label": "Local AI Lab", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La unidad de trabajo es un ensayo relacionado con snapshot, modelos, Worker, par\u00e1metros y hashes para conservar evidencia recuperable.", "id": "docs_manual_de_uso_local_ai_lab", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "local ai lab"}, {"label": "Coordinator", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_manual_de_uso_coordinator", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "coordinator"}, {"label": "Worker", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_manual_de_uso_worker", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "worker"}, {"label": "AI Broker mediante contrato HTTP p\u00fablico", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La integraci\u00f3n usa health, capabilities y tareas de modelo exacto para comprobar la fase correspondiente sin acceder a la persistencia o configuraci\u00f3n del servicio externo.", "id": "docs_manual_de_uso_ai_broker", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "ai broker mediante contrato http publico"}, {"label": "Model Drift mediante CLI evaluar-tratamientos", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_manual_de_uso_model_drift", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "model drift mediante cli evaluar-tratamientos"}, {"label": "Vault de solo lectura y snapshot COMPLETE", "file_type": "rationale", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshots e \u00edndices se escriben fuera del vault para preservar las notas; un cambio durante la lectura deja el snapshot INCOMPLETE y exige crear otro.", "id": "docs_manual_de_uso_vault_read_only", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "vault de solo lectura y snapshot complete"}, {"label": "Capacidades detectadas frente a capacidades probadas", "file_type": "rationale", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un probe solo detecta una capacidad; \u00fanicamente una carga real aporta evidencia recuperable suficiente para declararla probada. UNKNOWN expresa falta de comprobaci\u00f3n.", "id": "docs_manual_de_uso_capacidades_probadas", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "capacidades detectadas frente a capacidades probadas"}, {"label": "Identidad exacta de modelos sin fallback", "file_type": "rationale", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ruta o ID y SHA-256 fijan el modelo y su cach\u00e9 para evitar cambios silenciosos y permitir comparaciones reproducibles; los modelos deben estar disponibles localmente.", "id": "docs_manual_de_uso_modelo_exacto", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "identidad exacta de modelos sin fallback"}, {"label": "R1: RAG lexical controlado", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_manual_de_uso_r1", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "r1: rag lexical controlado"}, {"label": "Comparaci\u00f3n R3 h\u00edbrido frente a R4 con grafo y wikilinks", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La comparaci\u00f3n exige igual suite, snapshot, casos, k, embeddings y modelo generativo; R4 es una alternativa experimental cuya superioridad depende de la configuraci\u00f3n y requiere potencia suficiente.", "id": "docs_manual_de_uso_r3_r4", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "comparacion r3 hibrido frente a r4 con grafo y wikilinks"}, {"label": "Benchmark humano HUMAN_APPROVED", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_manual_de_uso_benchmark_humano", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "benchmark humano human_approved"}, {"label": "Revisi\u00f3n aceptada y aprobaci\u00f3n separada para entrenamiento", "file_type": "rationale", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Corregir, aceptar y aprobar entrenamiento son decisiones distintas: la segunda aprobaci\u00f3n revisa calidad, privacidad, licencia y contaminaci\u00f3n antes de incluir el ejemplo.", "id": "docs_manual_de_uso_doble_aprobacion", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "revision aceptada y aprobacion separada para entrenamiento"}, {"label": "Dataset aprobado READY_FOR_TRAINING", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Una semilla estable permite reproducir los splits; deduplicaci\u00f3n y exclusi\u00f3n de IDs y fingerprints de benchmarks evitan contaminaci\u00f3n y reutilizaci\u00f3n silenciosa.", "id": "docs_manual_de_uso_dataset_aprobado", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "dataset aprobado ready_for_training"}, {"label": "Preflight C1\u2013C6, ocho ejemplos, checkpoint y resume", "file_type": "rationale", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La prueba corta verifica compatibilidad, memoria, checkpoint, reanudaci\u00f3n y recarga en el Worker y modelo concretos antes de autorizar entrenamiento largo.", "id": "docs_manual_de_uso_preflight", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "preflight c1\u2013c6, ocho ejemplos, checkpoint y resume"}, {"label": "Entrenamiento LoRA autorizado", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_manual_de_uso_lora", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "entrenamiento lora autorizado"}, {"label": "Destilaci\u00f3n secuencial supervisada profesor \u2192 alumno", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El profesor servido por Broker o cargado localmente genera respuestas que aprende un alumno local distinto mediante LoRA; se conservan respuestas, procedencia, hashes y t\u00e9rminos autorizados.", "id": "docs_manual_de_uso_destilacion", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "destilacion secuencial supervisada profesor \u2192 alumno"}, {"label": "PEFT para crear, guardar, reanudar y recargar adapters LoRA", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "id": "docs_manual_de_uso_peft", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "peft para crear, guardar, reanudar y recargar adapters lora"}, {"label": "Evaluaci\u00f3n F1 contra B1 y F2 contra R4", "file_type": "rationale", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La suite, los casos, snapshot, \u00edndice y par\u00e1metros del baseline quedan fijados para medir la ganancia de verificaci\u00f3n. Formato y citas requieren adem\u00e1s revisi\u00f3n humana de fidelidad antes de promover el modelo.", "id": "docs_manual_de_uso_evaluacion_f1_f2", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "evaluacion f1 contra b1 y f2 contra r4"}, {"label": "Exportaci\u00f3n experimental verificable", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solo se exportan entrenamientos completados y formatos probados por el Worker; licencia, manifest y hashes deben revisarse antes de mover o publicar el paquete.", "id": "docs_manual_de_uso_exportacion", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "exportacion experimental verificable"}, {"label": "Recuperaci\u00f3n de entrenamiento: reanudar, reiniciar o descartar", "file_type": "rationale", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un entrenamiento interrumpido no se repite autom\u00e1ticamente. Una sola decisi\u00f3n crea el trabajo de recuperaci\u00f3n conservando historial y estado exacto; en destilaci\u00f3n conserva respuestas del profesor para evitar repetir generaci\u00f3n y coste.", "id": "docs_manual_de_uso_recuperacion_entrenamiento", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "recuperacion de entrenamiento: reanudar, reiniciar o descartar"}, {"label": "Misiones y planes persistidos con evidencia por etapa", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El estado de cada etapa se calcula a partir de productos, jobs y revisiones vinculados y de su cadena de procedencia. Visitar una pantalla o tener un resultado satisfactorio de la categor\u00eda correcta no demuestra que corresponda a la misi\u00f3n; la tarea, el criterio de \u00e9xito y el contenido requieren revisi\u00f3n humana.", "id": "docs_manual_de_uso_misiones", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "misiones y planes persistidos con evidencia por etapa"}, {"label": "Cuota de artefactos CAS y limpieza revisada", "file_type": "rationale", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La cuota reserva transferencias pendientes y la limpieza revalida referencias para proteger resultados y trabajos. Las propuestas limitadas a 200 elementos caducan en 24 horas y una aprobaci\u00f3n durable permite completar un borrado interrumpido.", "id": "docs_manual_de_uso_cuota_limpieza", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "cuota de artefactos cas y limpieza revisada"}, {"label": "Copia y restauraci\u00f3n verificable de SQLite y artefactos", "file_type": "concept", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La copia requiere detener los Coordinators; la restauraci\u00f3n verifica archivos e integridad SQLite antes de publicar una carpeta nueva y protege datos privados y hashes de credenciales.", "id": "docs_manual_de_uso_backup_restore", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "copia y restauracion verificable de sqlite y artefactos"}, {"label": "Cadena de procedencia de evidencia de misiones", "file_type": "rationale", "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un experimento debe usar el benchmark de la misi\u00f3n, la revisi\u00f3n pertenecer al experimento y la comparaci\u00f3n incluir los experimentos completos vinculados. Dataset, preflight, modelo evaluado y exportaci\u00f3n deben corresponder entre s\u00ed; destilaci\u00f3n exige profesor y alumno del plan. Se rechazan resultados ajenos, los requisitos pendientes mantienen Configurado y retirar evidencia o cambiar modelos recalcula el avance conservando los v\u00ednculos para revisi\u00f3n. La coherencia entre tarea, criterio y contenido requiere revisi\u00f3n humana.", "id": "docs_manual_de_uso_cadena_procedencia_misiones", "community": 10, "community_name": "Manual y seguridad actuales", "norm_label": "cadena de procedencia de evidencia de misiones"}], "edges": [{"relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "weight": 1, "source": "docs_manual_de_uso_manual_de_uso", "target": "docs_manual_de_uso_local_ai_lab"}, {"relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "weight": 1, "source": "docs_manual_de_uso_manual_de_uso", "target": "docs_release_status_20260929_release_status"}, {"relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "weight": 1, "source": "docs_manual_de_uso_local_ai_lab", "target": "docs_manual_de_uso_ai_broker"}, {"relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "weight": 1, "source": "docs_manual_de_uso_local_ai_lab", "target": "docs_manual_de_uso_coordinator"}, {"relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "weight": 1, "source": "docs_manual_de_uso_local_ai_lab", "target": "docs_manual_de_uso_r1"}, {"relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "weight": 1, "source": "docs_manual_de_uso_local_ai_lab", "target": "docs_manual_de_uso_vault_read_only"}, {"relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "weight": 1, "source": "docs_manual_de_uso_local_ai_lab", "target": "docs_manual_de_uso_worker"}, {"relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/MANUAL_DE_USO.md", "source_location": null, "weight": 1, "source": "docs_manual_de_uso_backup_restore", "target": "docs_manual_de_uso_coordinator"}, {"relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/MANUAL_