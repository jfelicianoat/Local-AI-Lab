{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local AI Lab",
  "version": "0.1.0",
  "identifier": "lab.localai.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Local AI Lab", "width": 1500, "height": 940, "minWidth": 780, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; connect-src 'self'; img-src 'self' asset:; style-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["resources/local-ai-lab-coordinator.exe"]
  }
}
