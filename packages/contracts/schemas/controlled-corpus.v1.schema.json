{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-lab.invalid/schemas/controlled-corpus.v1.schema.json",
  "title": "Local AI Lab Controlled Corpus v1",
  "type": "object",
  "required": ["schema_version", "suite_id", "suite_version", "purpose", "training_eligible", "documents", "cases", "human_review"],
  "properties": {
    "schema_version": {"const": "controlled-corpus.v1"},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_version": {"type": "string", "minLength": 1},
    "purpose": {"const": "benchmark_only"},
    "training_eligible": {"const": false},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["document_id", "relative_path"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "pattern": "^documents/.+\\.md$"}
        }
      }
    },
    "cases": {"type": "array", "minItems": 1},
    "human_review": {
      "type": "object",
      "required": ["status", "reviewer", "reviewed_at", "notes"],
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "notes": {"type": "string"}
      }
    }
  }
}
