{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-lab.invalid/schemas/real-benchmark.v1.schema.json",
  "title": "Local AI Lab Real Benchmark v1",
  "type": "object",
  "required": ["schema_version", "suite_id", "version", "purpose", "training_eligible", "snapshot_hash", "human_review", "cases"],
  "properties": {
    "schema_version": {"const": "real-benchmark.v1"},
    "suite_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "purpose": {"const": "external_validity"},
    "training_eligible": {"const": false},
    "snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "human_review": {
      "type": "object",
      "required": ["status", "reviewer_kind", "reviewer", "reviewed_at"],
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected"]},
        "reviewer_kind": {"const": "human"},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": ["string", "null"]}
      }
    },
    "cases": {"type": "array", "minItems": 1}
  }
}
